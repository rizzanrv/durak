# Copy to .env and fill in. Never commit the real .env.
PORT=3000

# Signing key for session tokens. Generate one: openssl rand -hex 32
# If omitted the server generates a random key per process, so every restart
# logs everybody out.
JWT_SECRET=

# Optional: SMTP for the password-reset / verification mails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
